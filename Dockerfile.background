FROM node:20.20.2-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:20.20.2-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080

RUN addgroup --system --gid 1001 kaska \
  && adduser --system --uid 1001 --ingroup kaska kaska

COPY --from=dependencies /app/node_modules ./node_modules
COPY --chown=kaska:kaska package.json package-lock.json tsconfig.json ./
COPY --chown=kaska:kaska src ./src
COPY --chown=kaska:kaska worker ./worker

USER kaska
EXPOSE 8080
CMD ["npm", "run", "service:background"]
