{
  "name": "kaska-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/main.ts",
    "scheduler": "tsx scheduler/main.ts",
    "seed:agents": "tsx src/db/seed/agents.ts",
    "audit:phase6": "tsx scripts/audit-phase6.ts",
    "audit:phase7": "tsx scripts/audit-phase7.ts",
    "test:phase7": "tsx --test src/core/execution/providers/tool-policy.test.ts src/modules/schedules/domain/recurring-job.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test src/core/execution/prompts/build-system-prompt.test.ts src/core/execution/providers/provider-error.test.ts src/modules/agents/domain/agent.test.ts src/modules/identity/application/provision-circle-wallet.test.ts src/modules/identity/domain/clerk-user-event.test.ts src/modules/identity/domain/ownership.test.ts src/modules/identity/domain/wallet-provisioning-policy.test.ts src/modules/payments/domain/task-payment.test.ts src/modules/payments/domain/usdc.test.ts src/modules/schedules/domain/recurring-job.test.ts src/modules/tasks/application/parse-create-task.test.ts src/modules/tasks/domain/task-id.test.ts src/modules/tasks/domain/task-lease.test.ts src/modules/tasks/domain/task-retry.test.ts src/modules/tasks/domain/task-status.test.ts src/modules/tasks/domain/task-workflow.test.ts src/modules/wallets/domain/wallet-balance.test.ts src/modules/wallets/domain/wallet-transaction.test.ts src/modules/wallets/domain/withdrawal.test.ts",
    "lint": "eslint",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:phase7 && npm run build"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.6.0",
    "@clerk/nextjs": "^7.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "openai": "^6.48.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.10.0",
    "svix": "^1.95.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.52.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
