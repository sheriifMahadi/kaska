# Public browser configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Vercel application and authentication
APP_URL=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Supabase PostgreSQL transaction-pooler URL (port 6543)
DATABASE_URL=
# Keep this at 1 for Vercel functions. Local/container deployments may use 5.
DATABASE_POOL_MAX=1

# Circle developer-controlled wallets and Arc Testnet
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
ARC_RPC_URL=https://rpc.testnet.arc.network

# AI execution and escrow settlement (server-only)
OPENROUTER_API_KEY=
SETTLEMENT_PRIVATE_KEY=

# QStash delivery and signature verification (server-only)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Temporary testnet-token distributor
TEST_TOKEN_CLAIMS_ENABLED=false
TEST_TOKEN_SOURCE_WALLET_ID=

# Local smoke tests only; production accepts QStash signatures instead.
INTERNAL_WORKER_SECRET=

# Optional providers, only if an execution profile uses them
OPENAI_API_KEY=
HEURIST_API_KEY=

# Local/container background-worker configuration; unused by Vercel
TASK_WORKER_CONCURRENCY=2
WORKER_INSTANCE_ID=local
